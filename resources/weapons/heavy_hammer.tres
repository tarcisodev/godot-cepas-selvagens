[resource]
script = ExtResource("1_style")
id = &"heavy_hammer"
display_name = "Arma pesada"
description = "Martelo de guerra: clique esquerdo desfere balanços rápidos de impacto. Botão direito executa uma investida demolidora pesada que quebra carapaças e Postura."
