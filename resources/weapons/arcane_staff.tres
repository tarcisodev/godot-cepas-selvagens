[resource]
script = ExtResource("1_style")
id = &"arcane_staff"
display_name = "Cajado arcano"
description = "Mouse 1 desfere golpe físico de cajado (Vigor) e Mouse 2 dispara Dardo Arcano à distância (Éter). Apertar Mouse 1 + Mouse 2 juntos conjura o golpe especial Explosão Astral em área."
