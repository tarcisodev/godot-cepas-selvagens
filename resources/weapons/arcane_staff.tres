secondary = SubResource("Attack_bolt")
special = SubResource("Attack_astral_burst")
aim_attack = SubResource("Attack_bolt")
pieces = Array[ExtResource("3_piece")]([SubResource("Piece_staff"), SubResource("Piece_satchel")])
