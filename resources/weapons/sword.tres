[resource]
script = ExtResource("1_style")
id = &"sword"
display_name = "Espada"
description = "Mouse 1 desfere combo rápido cortante e Mouse 2 aplica um corte pesado que quebra Postura. Apertar Mouse 1 + Mouse 2 juntos executa o golpe especial Turbilhão de Aço em 360°."
weight = 10.0
primary = SubResource("Attack_combo")
secondary = SubResource("Attack_heavy")
special = SubResource("Attack_whirlwind")
pieces = Array[ExtResource("3_piece")]([SubResource("Piece_sword"), SubResource("Piece_pauldron_l")])
