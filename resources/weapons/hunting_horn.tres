[resource]
script = ExtResource("1_style")
id = &"hunting_horn"
display_name = "Berrante de Caça"
description = "Trompa-clava colossal de duas mãos. Mouse 1 desfere o Golpe Acústico (🎵 Sol) e Mouse 2 aplica a Batida Harmônica pesada (🎶 Brisa / 🎼 Lume). Apertar Mouse 1 + Mouse 2 juntos executa o golpe especial Recital Ressonante em 360°, ativando a Melodia das notas acumuladas!"
weight = 26.0
primary = SubResource("Attack_swing")
secondary = SubResource("Attack_harmony")
special = SubResource("Attack_recital")
pieces = Array[ExtResource("3_piece")]([SubResource("Piece_horn"), SubResource("Piece_pauldron_l"), SubResource("Piece_pauldron_r")])
