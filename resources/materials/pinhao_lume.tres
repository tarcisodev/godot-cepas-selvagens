[ext_resource type="Script" path="res://scripts/data/material_data.gd" id="1_mat"]

[resource]
script = ExtResource("1_mat")
id = &"pinhao_lume"
display_name = "Pinhão-Lume"
description = "Semente da Pinheira-Lume. Cada pinhão leva o genoma da árvore que vai nascer: cor da luz, copa e desenho da pinha. Plante pela roda rápida [G] em terra firme (na vila, só num Canteiro de Cultivo); o broto aparece em 2 dias."
category = 1
icon = "🌰"
color = Color(0.55, 0.36, 0.22, 1)
unit_weight = 0.05
max_gather_quality = 5
base_value = 3
tool_action = &"plantar"
